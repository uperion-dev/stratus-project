+        vec2 screen = mix(screenBegin, screenEnd, fraction);
+        if (min(screen.x, screen.y) < 0.001 || max(screen.x, screen.y) > 0.999) break;
+        float reciprocal = mix(reciprocalBegin, reciprocalEnd, fraction);
